{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-openssl": "*",
        "cweagans/composer-patches": "*",
        "erag/laravel-lang-sync-inertia": "^2.3",
        "inertiajs/inertia-laravel": "^3.3.1",
        "keepsuit/laravel-opentelemetry": "^2.2.5",
        "laravel-notification-channels/webpush": "^12.1.0",
        "laravel/framework": "^13.25",
        "laravel/nightwatch": "^1.28.7",
        "laravel/octane": "^2.19.0",
        "laravel/socialite": "^5.29.0",
        "laravel/telescope": "^5.22.1",
        "laravel/tinker": "^3.0.2",
        "laravel/wayfinder": "^0.1.21",
        "open-telemetry/transport-grpc": "^1.2",
        "php-ds/php-ds": "^2.0.1",
        "socialiteproviders/twitch": "^5.4.0",
        "spatie/laravel-data": "^4.23.0",
        "tightenco/ziggy": "^2.6.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4.1",
        "barryvdh/laravel-ide-helper": "^3.7.0",
        "brianium/paratest": "^7.24.0",
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10.0",
        "laravel/boost": "^2.5.3",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.30.5",
        "laravel/sail": "^1.66.0",
        "mockery/mockery": "^1.6.13",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.1.1",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "phpunit/phpunit": "13.3.0",
        "rector/rector": "^2.6.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "helper": [
            "@php artisan ide-helper:generate --helpers",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models --write-mixin"
        ],
        "lint": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "dev:octane": [
            "Composer\\Config::disableProcessTimeout",
            "CADDY_SERVER_EXTRA_DIRECTIVES='@devtoolsjson path /.well-known/appspecific/com.chrome.devtools.json reverse_proxy @devtoolsjson localhost:5173' php artisan octane:start --watch --host=localhost"
        ],
        "debug:octane": [
            "Composer\\Config::disableProcessTimeout",
            "CADDY_SERVER_EXTRA_DIRECTIVES='@devtoolsjson path /.well-known/appspecific/com.chrome.devtools.json reverse_proxy @devtoolsjson localhost:5173' frankenphp php-cli -dxdebug.mode=debug -dxdebug.start_with_request=yes -dxdebug.client_host=127.0.0.1 -dxdebug.client_port=9003 artisan octane:start --watch --host=localhost"
        ],
        "dev:ssr": [
            "bun run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        },
        "patches": {
            "keepsuit/laravel-opentelemetry": {
                "Drop empty-datapoint metrics before OTLP export (Grafana Cloud/Mimir rejects the whole batch otherwise, e.g. the SDK's own otel.sdk.* self-diagnostics counters)": "patches/keepsuit-laravel-opentelemetry-drop-empty-metrics.patch"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": true,
            "cweagans/composer-patches": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
